{
  "name": "skyguard-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SkyGuard — Weather Alerts and Climate Risk Intelligence Platform",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "dev:api": "powershell -Command \".\\services\\api\\.venv\\Scripts\\python.exe -m uvicorn services.api.app.main:app --reload --port 8000\"",
    "test:api": "powershell -Command \".\\services\\api\\.venv\\Scripts\\python.exe -m pytest services/api/tests -v\""
  },
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
