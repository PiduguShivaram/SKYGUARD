# SkyGuard Environment Variables Template
# Copy this file to .env and configure local values.
# NEVER commit sensitive credentials or API keys.

# Backend API Configuration
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upstream API Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# India Meteorological Department (IMD) / SACHET Credentials (Optional / Future)
# Leave blank unless authorized access token is provisioned.
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/public

# Google Earth Engine (GEE) Credentials (Optional / Future)
# Leave blank until authorized GEE service account is provisioned.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY=

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
